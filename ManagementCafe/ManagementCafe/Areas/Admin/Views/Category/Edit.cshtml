<div class="col-lg-10">
    <div class="card">
        <div class="card-header">
            <strong>Chỉnh sửa loại sản phẩm</strong>
        </div>
        <div class="card-body card-block">
            <form asp-action="Edit" method="post" enctype="multipart/form-data" class="form-horizontal">
                <input type="hidden" name="ProductId" value="@Model.CateId" />

                <div class="row form-group">
                    <div class="col col-md-3">
                        <label for="name-input" class="form-control-label">Tên sản phẩm</label>
                    </div>
                    <div class="col-12 col-md-9">
                        <input type="text" id="name-input" name="Name" value="@Model.Name" placeholder="Tên sản phẩm" class="form-control" required />
                    </div>
                </div>
                
                <div class="card-footer">
                    <input type="submit" value="Lưu" class="btn btn-primary btn-sm" />
                    <a asp-action="Index" class="btn btn-danger btn-sm">Hủy</a>
                </div>
            </form>
        </div>
    </div>
</div>
