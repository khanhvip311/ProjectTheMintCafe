@model IEnumerable<ManagementCafe.Models.PartyTable>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}



<div class="breadcrumbs">
    <div class="col-sm-4">
        <div class="page-header float-left">
            <div class="page-title">
                <h1>Quản lý bàn tiệc</h1>
            </div>
        </div>
    </div>
    @* <div class="col-sm-8">
        <div class="page-header float-right">
            <div class="page-title">
                <ol class="breadcrumb text-right">
                    <li><a href="#">Quản lý thực đơn</a></li>
                    <li><a href="#">Table</a></li>
                    <li class="active">Data table</li>
                </ol>
            </div>
        </div>
    </div> *@
</div>

<div class="content mt-3">
    <div class="animated fadeIn">
        <div class="row">

            <div class="col-md-12">
                <div class="card">
                    <div class="card-header">
                        <strong class="card-title">Danh sách bàn tiệc</strong>
                        <a asp-action="Create" class="btn btn-primary float-right">Thêm mới</a>
                    </div>

                    <div class="d-inline-flex align-items-center mt-3 ml-2" style="white-space: nowrap;">
                        <label class="mb-0 mr-2">Tìm kiếm:</label>
                        <input type="search" id="searchInput" class="form-control form-control-sm w-50" placeholder="Nhập từ khóa..." onkeyup="searchTable()" aria-controls="bootstrap-data-table-export" />
                    </div>

                    <div class="card-body">
                        <table id="bootstrap-data-table-export" class="table table-striped table-bordered">
                            <thead>
                                <tr>
                                    <th>Số bàn</th>
                                    <th>Trạng thái</th>
                                    <th>Số người</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td>@item.TableId</td>
                                        <td>
                                            @item.Status
                                        </td>
                                        <td>
                                            @item.Capacity
                                        </td>
                                        <td>
                                            <button class="btn btn-info viewDetailsBtn"
                                                    data-id="@item.TableId"
                                                    data-status="@item.Status"
                                                    data-capacity="@item.Capacity">
                                                Xem chi tiết
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>


        </div>
    </div><!-- .animated -->
</div><!-- .content -->

<!-- Modal -->
<div class="modal fade" id="tableDetailModal" tabindex="-1" role="dialog" aria-labelledby="tableModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="tableModalLabel">Chi tiết bàn tiệc</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <p><strong>Số bàn:</strong> <span id="modalTableId"></span></p>
                <p><strong>Trạng thái:</strong> <span id="modalTableStatus"></span></p>
                <p><strong>Số người:</strong> <span id="modalTableCapacity"></span></p>
            </div>
            <div class="modal-footer">
                <a href="#" id="editTableBtn" class="btn btn-warning"><i class="fa fa-edit"></i> Chỉnh sửa</a>
                <a href="#" id="deleteTableBtn" class="btn btn-danger"><i class="fa fa-trash"></i> Xóa</a>
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

<!-- Thêm jQuery -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<!-- Thêm Bootstrap JS -->
<script src="https://maxcdn.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>

<script>
    $(document).ready(function () {
        $(".viewDetailsBtn").click(function () {
            var tableId = $(this).data("id");
            var tableStatus = $(this).data("status");
            var tableCapacity = $(this).data("capacity");

            $("#modalTableId").text(tableId);
            $("#modalTableStatus").text(tableStatus);
            $("#modalTableCapacity").text(tableCapacity);

            $("#editTableBtn").attr("href", "/Admin/PartyTable/Edit/" + tableId);
            $("#deleteTableBtn").attr("data-id", tableId);

            $("#tableDetailModal").modal("show");
        });

        $("#deleteTableBtn").click(function (e) {
            e.preventDefault();
            var tableId = $(this).attr("data-id");
            if (confirm("Bạn có chắc chắn muốn xóa bàn tiệc này không?")) {
                window.location.href = "/Admin/PartyTable/Delete/" + tableId;
            }
        });
    });

    function searchTable() {
        let input = document.getElementById("searchInput").value.toLowerCase().trim();
        let rows = document.querySelectorAll("#bootstrap-data-table-export tbody tr");

        rows.forEach(row => {
            let nameCell = row.querySelector("td:first-child"); // Lấy ô chứa tên món
            if (nameCell) {
                let itemName = nameCell.innerText.toLowerCase();
                row.style.display = itemName.includes(input) ? "" : "none";
            }
        });
    }
</script>
