<div class="col-lg-10">
    <div class="card">
        <div class="card-header">
            <strong>Chỉnh sửa bàn </strong>
        </div>
        <div class="card-body card-block">
            <form asp-action="Edit" method="post" enctype="multipart/form-data" class="form-horizontal">
                
                <div class="row form-group">
                    <div class="col col-md-3">
                        <label for="name-input" class="form-control-label">Số bàn</label>
                    </div>
                    <div class="col-12 col-md-9">
                        <input type="text" id="name-input" name="TableId" value="@Model.TableId" placeholder="Số bàn" class="form-control" readonly />
                    </div>
                </div>
                <div class="row form-group">
                    <div class="col col-md-3">
                        <label for="name-input" class="form-control-label">Trạng thái</label>
                    </div>
                    <div class="col-12 col-md-9">
                        <input type="text" id="name-input" name="Status" value="@Model.Status" placeholder="Trạng thái" class="form-control" />
                    </div>
                </div>
                <div class="row form-group">
                    <div class="col col-md-3">
                        <label for="name-input" class="form-control-label">Số người</label>
                    </div>
                    <div class="col-12 col-md-9">
                        <input type="text" id="name-input" name="Capacity" value="@Model.Capacity" placeholder="Số người" class="form-control" />
                    </div>
                </div>

                <div class="card-footer">
                    <input type="submit" value="Lưu" class="btn btn-primary btn-sm" />
                    <a asp-action="Index" class="btn btn-danger btn-sm">Hủy</a>
                </div>
            </form>
        </div>
    </div>
</div>

