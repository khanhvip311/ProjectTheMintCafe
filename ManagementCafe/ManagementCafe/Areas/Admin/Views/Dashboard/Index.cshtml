                    </div>
                </div>
            </div>
        </div>
    </div>




</div>
<!-- .content -->

<script>
    function searchTable() {
    let input = document.getElementById("searchInput").value.toLowerCase().trim();
    let rows = document.querySelectorAll("#bootstrap-data-table-export tbody tr");

    rows.forEach(row => {
        let text = row.innerText.toLowerCase();
        let words = text.split(/\s+/); // Tách thành mảng từ

        // Kiểm tra nếu bất kỳ từ nào trong dòng bắt đầu với input
        let isMatch = words.some(word => word.startsWith(input));

        row.style.display = isMatch ? "" : "none";
    });
    }
</script>